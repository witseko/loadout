{
  "name": "@singlet/t3code-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "T3 Code (pingdotgg/t3code) Effect-TS server plugin and React 19 UI integration for singlet: the zero-dependency AI agent skill switchboard.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./protocol": {
      "types": "./src/protocol.ts",
      "default": "./src/protocol.ts"
    },
    "./server": {
      "types": "./src/server/SingletService.ts",
      "default": "./src/server/SingletService.ts"
    },
    "./server/rpc": {
      "types": "./src/server/SingletRpcClient.ts",
      "default": "./src/server/SingletRpcClient.ts"
    },
    "./web": {
      "types": "./src/web/SingletSwitchboardDrawer.tsx",
      "default": "./src/web/SingletSwitchboardDrawer.tsx"
    },
    "./web/composer": {
      "types": "./src/web/ComposerSkillPickerBadge.tsx",
      "default": "./src/web/ComposerSkillPickerBadge.tsx"
    }
  },
  "files": [
    "src",
    "README.md",
    "tsconfig.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {},
  "peerDependencies": {
    "effect": "^3.12.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "singlet",
    "t3code",
    "skills",
    "effect-ts",
    "react",
    "claude-code",
    "codex",
    "opencode",
    "antigravity",
    "mcp"
  ]
}
